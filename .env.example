# Copy to .env.local. Local values below match scripts/mysql-local.sh.
# For Hostinger, use the hPanel database name, user and password (host 127.0.0.1 from the deployed app).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tableqr
DB_USER=tableqr
DB_PASSWORD=tableqr_local

# Realtime Worker (realtime/). Leave empty to run without it: screens then poll.
# Locally: npm run realtime:dev, and copy the two secrets from realtime/.dev.vars.
REALTIME_URL=
REALTIME_PUBLISH_SECRET=
REALTIME_TOKEN_SECRET=

# Guest OTP (G2). Keys the stored code hashes; required in production. Any long random string.
OTP_SECRET=

# G6 service-task scheduler callback. Required in deployed app and realtime Worker.
SERVICE_TASK_SECRET=
