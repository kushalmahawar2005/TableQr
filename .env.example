# Copy to .env.local. Local values below match scripts/mysql-local.sh.
# For Hostinger, use the hPanel database name, user and password (host 127.0.0.1 from the deployed app).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u892494227_tableqr
DB_USER=u892494227_tableqr
DB_PASSWORD=
# Open database connections per app process. Keep 10 on shared hosting; e.g. 40 on a VPS.
DB_POOL_SIZE=10
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_SESSION_SECRET=

# Realtime Worker (realtime/). Leave empty to run without it: screens then poll.
# Locally: npm run realtime:dev, and copy the two secrets from realtime/.dev.vars.
# Screens get this address from the server at request time; only signed short-lived tokens reach browsers.
REALTIME_URL=
REALTIME_PUBLISH_SECRET=
REALTIME_TOKEN_SECRET=

# Guest OTP (G2). Keys the stored code hashes; required in production. Any long random string.
OTP_SECRET=

# Indian OTP SMS: msg91 or fast2sms. Keep the mock sender for local development. Production sends
# only when the provider's credentials and an approved DLT OTP template (with the OTP variable,
# ##OTP## on MSG91) are configured; it never falls back to demo.
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=5
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_OTP_EXPIRY_MINUTES=5

# G6 service-task scheduler callback. Required in deployed app and realtime Worker.
SERVICE_TASK_SECRET=

# Public address of the app (QR codes, share links). Example: https://tableqr.example.com
PUBLIC_APP_URL=
NEXT_PUBLIC_APP_URL=
# Optional exact Hostinger/custom-domain CNAME destination. Falls back to the hostname above.
CUSTOM_DOMAIN_CNAME_TARGET=

# Staff background push. Generate a persistent pair with `npx web-push generate-vapid-keys`.
# Keep the private key server-only; set the same keys on every app instance and deployment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@your-domain.example

# TableQR subscriptions only (Cashfree). These belong to TableQR; never used for restaurant guest
# bills, delivery, or booking advances. Use sandbox locally/staging and production only on live HTTPS.
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01

# Encryption key for merchant credentials each restaurant enters in Console > Settings.
# Generate once with `openssl rand -hex 32`. Keep it stable across restarts and deployments; never
# reuse or change it after restaurant credentials have been saved, or those credentials cannot be
# decrypted. Restaurant merchant keys are separate from CASHFREE_CLIENT_ID/SECRET above.
PAYMENT_CREDENTIALS_KEY=

# Menu photos. "local" saves under public/uploads (a redeploy can wipe them); "r2" (or any other
# value) uses an S3-compatible bucket. Cloudflare R2: ENDPOINT https://<account id>.r2.cloudflarestorage.com,
# REGION auto, PUBLIC_URL the bucket's public address (r2.dev or your own domain), keys from an
# R2 API token with Object Read & Write on this bucket. Old local photos move over at the next start.
MENU_STORAGE_DRIVER=r2
MENU_STORAGE_BUCKET=
MENU_STORAGE_ENDPOINT=
MENU_STORAGE_REGION=
MENU_STORAGE_PUBLIC_URL=
MENU_STORAGE_ACCESS_KEY_ID=
MENU_STORAGE_SECRET_ACCESS_KEY=

# Development only. Production ignores mock modes.
# PAYMENTS_MOCK=1
# SMS_MOCK=1

# WhatsApp Business (Meta Cloud API): "Send PDF" on the billing screen sends the bill PDF to the
# guest's number. Leave empty: staff send the bill from their own WhatsApp instead.
# The template must be an approved Utility template with a Document header and a body with one
# variable for the restaurant name, e.g. "Your bill from {{1}}. Thank you for visiting!"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BILL_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
